PORT=3001
HOST=127.0.0.1

DEFAULT_AI_PROVIDER=1xai

# ---- API Keys (fallback اگر در providers.json خالی باشد) ----
ONEXAI_API_KEY=
X1AI_API_KEY=
OPENROUTER_API_KEY=
XKIRO_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
FREEBUFF_TOKEN=
SAMBANOVA_API_KEY=

# ---- Cloudflare (در providers.json از {{CLOUDFLARE_ACCOUNT_ID}} استفاده می‌شود) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# ---- تنظیمات ----
AI_MAX_OUTPUT_TOKENS=16384
AI_REQUEST_TIMEOUT_MS=120000
# Local Docker sandbox limits
AI_SANDBOX_IMAGE=node:22-alpine
AI_SANDBOX_MEMORY_MB=512
AI_SANDBOX_CPUS=1
AI_SANDBOX_MAX_SESSIONS=2
